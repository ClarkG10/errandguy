# ErrandGuy Mobile — Environment Variables
# Copy this to .env and fill in your values.
# In production, these are set in eas.json per build profile.

EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Laravel Reverb (realtime). KEY must match the API server's REVERB_APP_KEY.
# HOST/PORT/SCHEME point at the public WebSocket endpoint — with the nginx
# path-proxy setup that's your API domain on 443 over wss. For local dev
# against `php artisan reverb:start`, use HOST=localhost PORT=8080 SCHEME=http.
EXPO_PUBLIC_REVERB_KEY=
EXPO_PUBLIC_REVERB_HOST=localhost
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_SCHEME=http
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
EXPO_PUBLIC_MAPBOX_TOKEN=
EXPO_PUBLIC_XENDIT_PUBLIC_KEY=
