{
  "expo": {
    "name": "ErrandGuy",
    "slug": "errandguy",
    "scheme": "errandguy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-square.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/wordmark-stacked.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8FA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.errandguy.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ErrandGuy needs your location to find nearby runners and track deliveries.",
        "NSCameraUsageDescription": "ErrandGuy needs camera access to take photos of items and delivery proofs.",
        "NSPhotoLibraryUsageDescription": "ErrandGuy needs photo library access to upload item photos.",
        "NSPhotoLibraryAddUsageDescription": "ErrandGuy saves chat images to your photo library when you tap Save.",
        "NSFaceIDUsageDescription": "ErrandGuy uses Face ID to quickly and securely unlock your saved session.",
        "NSContactsUsageDescription": "ErrandGuy uses your contacts so you can quickly import a trusted contact for SOS.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.errandguy.app",
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0F6FE6",
        "foregroundImage": "./assets/android-icon-square.png",
        "monochromeImage": "./assets/android-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.READ_CONTACTS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ErrandGuy uses Face ID to quickly and securely unlock your saved session."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "ErrandGuy uses your contacts so you can quickly import a trusted contact for SOS."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "ErrandGuy needs photo library access to upload item photos.",
          "savePhotosPermission": "ErrandGuy saves chat images to your photo library when you tap Save.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-font",

      "expo-image"
    ],
    "web": {
      "favicon": "./assets/favicon-square.png"
    },
    "extra": {
      "eas": {
        "projectId": "1684a4bc-4b59-47f4-a87e-3b3262438098"
      },
      "router": {
        "root": "./src/app"
      }
    },
    "owner": "clark123"
  }
}
