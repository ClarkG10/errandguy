{
  "expo": {
    "name": "ErrandGuy",
    "slug": "errandguy",
    "scheme": "errandguy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-square.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo-new.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.errandguy.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ErrandGuy needs your location to find nearby runners and track deliveries.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "ErrandGuy uses your location in the background to update your position while on an active errand.",
        "NSCameraUsageDescription": "ErrandGuy needs camera access to take photos of items and delivery proofs.",
        "NSPhotoLibraryUsageDescription": "ErrandGuy needs photo library access to upload item photos.",
        "NSPhotoLibraryAddUsageDescription": "ErrandGuy saves chat images to your photo library when you tap Save.",
        "NSMicrophoneUsageDescription": "ErrandGuy needs microphone access for in-app calls.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.errandguy.app",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-square.png",
        "monochromeImage": "./assets/android-icon-square.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-secure-store",
      "expo-location",
      "expo-camera",
      "expo-image-picker",
      [
        "expo-media-library",
        {
          "photosPermission": "ErrandGuy needs photo library access to upload item photos.",
          "savePhotosPermission": "ErrandGuy saves chat images to your photo library when you tap Save.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-font",
      [
        "react-native-maps",
        {
          "googleMapsApiKey": "$(EXPO_PUBLIC_GOOGLE_MAPS_KEY)"
        }
      ],
      "expo-image"
    ],
    "web": {
      "favicon": "./assets/favicon-square.png"
    },
    "extra": {
      "eas": {
        "projectId": "1684a4bc-4b59-47f4-a87e-3b3262438098"
      },
      "router": {
        "root": "./src/app"
      }
    },
    "owner": "clark123"
  }
}
