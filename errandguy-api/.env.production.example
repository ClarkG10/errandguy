##############################################################################
# ErrandGuy API — Production Environment Template
# Copy this to .env on your production server and fill in all values.
##############################################################################

APP_NAME=ErrandGuy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.errandguy.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logging — "stack" for production (daily rotation)
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database — Forge-managed MySQL (local to the app server)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=errandguy
DB_USERNAME=errandguy
DB_PASSWORD=

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.errandguy.app

# Broadcasting — Laravel Reverb (self-hosted WebSocket server on this box)
BROADCAST_CONNECTION=reverb

# Reverb credentials. Generate ONCE per environment (php artisan reverb:install
# writes fresh values) and keep them secret — the APP_KEY is public (the mobile
# client uses it), but APP_SECRET signs channel-auth and must never ship to the
# client. Do NOT reuse the values committed to any example file.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# How THIS Laravel app publishes events to Reverb. Reverb runs on the same box
# (Forge daemon), so publish over loopback plain-HTTP — never back out through
# the public domain. These are the server→server values, NOT what the mobile
# app uses.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# What `php artisan reverb:start` binds to. 0.0.0.0:8080 stays internal; nginx
# reverse-proxies wss://<APP_URL host>/app  ->  127.0.0.1:8080 (path-proxy on
# the existing 443 cert). The MOBILE app connects with its OWN, separate vars:
#   EXPO_PUBLIC_REVERB_HOST=<your api domain>   PORT=443   SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# File Storage
FILESYSTEM_DISK=local

# Queue — Redis for production
QUEUE_CONNECTION=redis

# Cache — Redis for production
CACHE_STORE=redis

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sanctum
SANCTUM_STATEFUL_DOMAINS=errandguy.app,api.errandguy.app

# Firebase (Push Notifications)
# Path to firebase-credentials.json on server, or base64-encoded JSON
FIREBASE_CREDENTIALS=/home/forge/errandguy-api/firebase-credentials.json
FIREBASE_PROJECT_ID=

# Mail — REQUIRED. Sent through the Gmail API as support@errandguyph.com
# (password-reset and sign-in codes, email confirmation, SOS staff alerts).
# Mint the three GMAIL_OAUTH_* values once: docs/EMAIL_GMAIL_API_SETUP.md.
# errandguy:check-prod-config reports a log/unset mailer as CRITICAL.
MAIL_MAILER=gmail
MAIL_FROM_ADDRESS="support@errandguyph.com"
MAIL_FROM_NAME="${APP_NAME}"
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_IMPERSONATE="support@errandguyph.com"
# Shown on public pages such as /, /terms, /privacy and /delete-account.
SUPPORT_EMAIL="support@errandguyph.com"
# Version shown on /terms and /privacy; bump it when the published text changes.
PRIVACY_POLICY_VERSION=1.0

# Xendit (Payments)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Semaphore SMS (semaphore.co) — texts sent when someone presses SOS: to their
# trusted contacts and to the ops_alert_phone numbers set in the admin panel.
# Nothing is texted until SEMAPHORE_API_KEY is set. SEMAPHORE_SENDER_NAME must
# be approved on the Semaphore account (empty = the account default).
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
SEMAPHORE_PRIORITY=true

# Mapbox (Server-side geocoding if needed)
MAPBOX_SECRET_TOKEN=

##############################################################################
# Security — REQUIRED for correct rate-limiting + CORS in production
##############################################################################
# Trusted proxies — whose X-Forwarded-For the app believes for the client IP
# that every per-IP rate limit (sign-in, codes, sign-up) keys on. Behind
# Cloudflare (which *.on-forge.com domains are): `cloudflare` = Cloudflare's
# published edge ranges; add any load balancer's IP/CIDR after a comma. Also
# firewall the origin so it only accepts Cloudflare. EMPTY trusts nobody: every
# client then shares Cloudflare's IP and real users get rate-limited together
# (check-prod-config: CRITICAL). Never '*'. See App\Http\Middleware\TrustProxies.
TRUSTED_PROXIES=cloudflare
# Sanctum bearer-token TTL in minutes. Leaving this BLANK = tokens never expire
# (not recommended). 43200 = 30 days is a sane mobile default; shorten for tighter
# security at the cost of more frequent re-logins.
SANCTUM_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=eg_
# CORS — comma-separated fully-qualified origins. No wildcards in production.
CORS_ALLOWED_ORIGINS=https://errandguy.app,https://api.errandguy.app
# Request/upload body caps (bytes).
API_MAX_BODY_BYTES=1048576
API_MAX_UPLOAD_BYTES=12582912

##############################################################################
# Disaster recovery — REQUIRED (off-box backups)
##############################################################################
# MUST be 's3'. Nightly (02:30 Manila) the database dump AND an archive of the
# uploaded files (runner ID documents, chat/errand photos) are copied to this
# bucket; before every migrate a fresh database dump is too. A local copy of
# each dump is always kept as well. Left as 'local', a server/disk loss
# destroys the database and every backup together — errandguy:preflight FAILS.
# A failed upload raises an admin alert (the deploy still continues).
DB_BACKUP_DISK=s3
DB_BACKUP_PATH=backups
DB_BACKUP_RETENTION_DAYS=14
# Any S3-compatible bucket. Create a PRIVATE bucket and a key limited to it.
#   AWS S3:            AWS_ENDPOINT empty, AWS_DEFAULT_REGION=ap-southeast-1
#   Cloudflare R2:     AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#                      AWS_DEFAULT_REGION=auto
#   DigitalOcean:      AWS_ENDPOINT=https://sgp1.digitaloceanspaces.com
#                      AWS_DEFAULT_REGION=us-east-1 (Spaces goes by the endpoint)
#   Backblaze B2:      AWS_ENDPOINT=https://s3.<region>.backblazeb2.com
#                      AWS_DEFAULT_REGION=<region, e.g. us-west-004>
# AWS_USE_PATH_STYLE_ENDPOINT=true only if the provider asks for path-style
# URLs (e.g. MinIO). Check with: php artisan errandguy:preflight
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

##############################################################################
# Observability — Sentry (error monitoring). Inert until the DSN is set.
##############################################################################
# Paste the project DSN to switch Sentry on — no code change, no redeploy.
SENTRY_LARAVEL_DSN=
# Tag events with the deployed release for regression attribution.
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1.0
# Performance tracing sample rate (0 = APM off; raise to e.g. 0.1 for 10%).
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
# MUST stay false + 'none' — payments/PII app. See config/sentry.php.
SENTRY_SEND_DEFAULT_PII=false
SENTRY_MAX_REQUEST_BODY_SIZE=none
