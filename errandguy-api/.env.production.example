##############################################################################
# ErrandGuy API — Production Environment Template
# Copy this to .env on your production server and fill in all values.
##############################################################################

APP_NAME=ErrandGuy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.errandguy.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logging — "stack" for production (daily rotation)
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database — Forge-managed PostgreSQL (local to the app server)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=forge
DB_USERNAME=forge
DB_PASSWORD=
DB_SSLMODE=prefer

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.errandguy.app

# Broadcasting — Laravel Reverb (self-hosted WebSocket server on this box)
BROADCAST_CONNECTION=reverb

# Reverb credentials. Generate ONCE per environment (php artisan reverb:install
# writes fresh values) and keep them secret — the APP_KEY is public (the mobile
# client uses it), but APP_SECRET signs channel-auth and must never ship to the
# client. Do NOT reuse the values committed to any example file.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# How THIS Laravel app publishes events to Reverb. Reverb runs on the same box
# (Forge daemon), so publish over loopback plain-HTTP — never back out through
# the public domain. These are the server→server values, NOT what the mobile
# app uses.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# What `php artisan reverb:start` binds to. 0.0.0.0:8080 stays internal; nginx
# reverse-proxies wss://<APP_URL host>/app  ->  127.0.0.1:8080 (path-proxy on
# the existing 443 cert). The MOBILE app connects with its OWN, separate vars:
#   EXPO_PUBLIC_REVERB_HOST=<your api domain>   PORT=443   SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# File Storage
FILESYSTEM_DISK=local

# Queue — Redis for production
QUEUE_CONNECTION=redis

# Cache — Redis for production
CACHE_STORE=redis

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sanctum
SANCTUM_STATEFUL_DOMAINS=errandguy.app,api.errandguy.app

# Firebase (Push Notifications)
# Path to firebase-credentials.json on server, or base64-encoded JSON
FIREBASE_CREDENTIALS=/home/forge/errandguy-api/firebase-credentials.json
FIREBASE_PROJECT_ID=

# Resend (Email)
RESEND_API_KEY=
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@errandguy.app"
MAIL_FROM_NAME="${APP_NAME}"

# Xendit (Payments)
XENDIT_SECRET_KEY=
XENDIT_PUBLIC_KEY=
XENDIT_WEBHOOK_TOKEN=

# Mapbox (Server-side geocoding if needed)
MAPBOX_SECRET_TOKEN=
