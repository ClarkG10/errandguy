##############################################################################
# ErrandGuy API — Production Environment Template
# Copy this to .env on your production server and fill in all values.
##############################################################################

APP_NAME=ErrandGuy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.errandguy.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logging — "stack" for production (daily rotation)
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database — Forge-managed MySQL (local to the app server)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=errandguy
DB_USERNAME=errandguy
DB_PASSWORD=

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.errandguy.app

# Broadcasting — Laravel Reverb (self-hosted WebSocket server on this box)
BROADCAST_CONNECTION=reverb

# Reverb credentials. Generate ONCE per environment (php artisan reverb:install
# writes fresh values) and keep them secret — the APP_KEY is public (the mobile
# client uses it), but APP_SECRET signs channel-auth and must never ship to the
# client. Do NOT reuse the values committed to any example file.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# How THIS Laravel app publishes events to Reverb. Reverb runs on the same box
# (Forge daemon), so publish over loopback plain-HTTP — never back out through
# the public domain. These are the server→server values, NOT what the mobile
# app uses.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# What `php artisan reverb:start` binds to. 0.0.0.0:8080 stays internal; nginx
# reverse-proxies wss://<APP_URL host>/app  ->  127.0.0.1:8080 (path-proxy on
# the existing 443 cert). The MOBILE app connects with its OWN, separate vars:
#   EXPO_PUBLIC_REVERB_HOST=<your api domain>   PORT=443   SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# File Storage
FILESYSTEM_DISK=local

# Queue — Redis for production
QUEUE_CONNECTION=redis

# Cache — Redis for production
CACHE_STORE=redis

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sanctum
SANCTUM_STATEFUL_DOMAINS=errandguy.app,api.errandguy.app

# Firebase (Push Notifications)
# Path to firebase-credentials.json on server, or base64-encoded JSON
FIREBASE_CREDENTIALS=/home/forge/errandguy-api/firebase-credentials.json
FIREBASE_PROJECT_ID=

# Resend (Email)
RESEND_API_KEY=
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@errandguy.app"
MAIL_FROM_NAME="${APP_NAME}"

# Xendit (Payments)
XENDIT_SECRET_KEY=
XENDIT_PUBLIC_KEY=
XENDIT_WEBHOOK_TOKEN=

# Mapbox (Server-side geocoding if needed)
MAPBOX_SECRET_TOKEN=

##############################################################################
# Security — REQUIRED for correct rate-limiting + CORS in production
##############################################################################
# Trusted proxy CIDRs (Cloudflare + any LB). MUST be set to the specific edge
# ranges AND the origin firewalled to Cloudflare-only — otherwise on a
# *.on-forge.com host Laravel auto-trusts ALL proxies and the X-Forwarded-For
# (and therefore every IP-keyed throttle: login/otp/forgot-password) becomes
# attacker-spoofable. Never use '*'. See bootstrap/app.php for the full rationale.
TRUSTED_PROXIES=
# Sanctum bearer-token TTL in minutes. Leaving this BLANK = tokens never expire
# (not recommended). 43200 = 30 days is a sane mobile default; shorten for tighter
# security at the cost of more frequent re-logins.
SANCTUM_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=eg_
# CORS — comma-separated fully-qualified origins. No wildcards in production.
CORS_ALLOWED_ORIGINS=https://errandguy.app,https://api.errandguy.app
# Request/upload body caps (bytes).
API_MAX_BODY_BYTES=1048576
API_MAX_UPLOAD_BYTES=12582912

##############################################################################
# Disaster recovery — REQUIRED (off-box backups)
##############################################################################
# MUST be 's3' (or another off-box disk). Left as 'local', the nightly + the
# pre-migrate DB dumps land on the SAME disk as the database — a server/disk
# loss destroys the DB and every backup together. Set the AWS_* values below.
DB_BACKUP_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

##############################################################################
# Observability — Sentry (error monitoring). Inert until the DSN is set.
##############################################################################
# Paste the project DSN to switch Sentry on — no code change, no redeploy.
SENTRY_LARAVEL_DSN=
# Tag events with the deployed release for regression attribution.
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1.0
# Performance tracing sample rate (0 = APM off; raise to e.g. 0.1 for 10%).
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
# MUST stay false + 'none' — payments/PII app. See config/sentry.php.
SENTRY_SEND_DEFAULT_PII=false
SENTRY_MAX_REQUEST_BODY_SIZE=none
