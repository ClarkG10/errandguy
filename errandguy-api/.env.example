APP_NAME=ErrandGuy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# ── Database ──────────────────────────────────────────────────────────────
# LOCAL / small deploy: point straight at the direct Supabase endpoint (5432).
# PRODUCTION AT SCALE: point `pgsql` at the Supavisor TRANSACTION pooler so
# many PHP-FPM workers multiplex onto a small server-side pool instead of
# exhausting the direct-connection cap — the #1 ceiling for 10k concurrent.
# Then also fill in the DB_DIRECT_* block (migrations run there). Full steps:
# docs/scaling-tier0-rollout.md.
#
#   Pooler (request traffic):   aws-<region>.pooler.supabase.com : 6543
#                               username  postgres.<project-ref>
#                               DB_EMULATE_PREPARES=true
#   Direct (migrations only):   db.<project-ref>.supabase.co : 5432
#                               username  postgres
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require
# Set true ONLY when DB_HOST is the transaction pooler (:6543).
DB_EMULATE_PREPARES=false
# Direct/session-mode endpoint for migrations. Leave blank on a direct-only
# setup (falls back to DB_HOST/DB_PORT). Set these when pgsql uses the pooler:
DB_DIRECT_HOST=
DB_DIRECT_PORT=5432
DB_DIRECT_USERNAME=postgres

# ── Cache / Session / Queue ───────────────────────────────────────────────
# Mobile Bearer auth is stateless, so the session store is off the hot path;
# still, PRODUCTION should run all three on Redis. `file` cache serialises
# every request's rate-limit + throttle check through flock'd disk I/O, and a
# `database` queue polls the same Postgres that is the bottleneck. Flip to:
#   CACHE_STORE=redis  SESSION_DRIVER=redis  QUEUE_CONNECTION=redis
# (Redis config is already wired below; needs the phpredis extension on the
# host + a Redis queue worker daemon. See the rollout doc.)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting via Laravel Reverb. Locally, `php artisan reverb:start` binds
# 127.0.0.1:8080 and this app publishes to it over the same loopback. Run
# `php artisan reverb:install` to generate the APP_ID/KEY/SECRET below. Set
# BROADCAST_CONNECTION=log if you don't want a Reverb server running in dev.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@errandguy.app"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:8081
# Token TTL in minutes (default 30 days). Set to a low value in
# high-risk environments, leave blank for no expiration (dev only).
SANCTUM_EXPIRATION=43200
# Optional prefix to make leaked tokens easy to spot in scanners.
SANCTUM_TOKEN_PREFIX=eg_

# CORS — comma separated list of fully-qualified origins.
# Wildcards are NOT supported in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Request body size limits (bytes)
API_MAX_BODY_BYTES=1048576
API_MAX_UPLOAD_BYTES=12582912

# Firebase (Push Notifications)
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=

# Resend (Email)
RESEND_API_KEY=

# Xendit (Payments)
XENDIT_SECRET_KEY=
XENDIT_PUBLIC_KEY=
XENDIT_WEBHOOK_TOKEN=

# Supabase (Storage)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Mapbox
MAPBOX_SECRET_TOKEN=
