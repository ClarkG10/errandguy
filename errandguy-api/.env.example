APP_NAME=ErrandGuy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@errandguy.app"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:8081
# Token TTL in minutes (default 30 days). Set to a low value in
# high-risk environments, leave blank for no expiration (dev only).
SANCTUM_EXPIRATION=43200
# Optional prefix to make leaked tokens easy to spot in scanners.
SANCTUM_TOKEN_PREFIX=eg_

# CORS — comma separated list of fully-qualified origins.
# Wildcards are NOT supported in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Request body size limits (bytes)
API_MAX_BODY_BYTES=1048576
API_MAX_UPLOAD_BYTES=12582912

# Firebase (Push Notifications)
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=

# Resend (Email)
RESEND_API_KEY=

# Xendit (Payments)
XENDIT_SECRET_KEY=
XENDIT_PUBLIC_KEY=
XENDIT_WEBHOOK_TOKEN=

# Supabase (Storage)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Mapbox
MAPBOX_SECRET_TOKEN=
