# ─── App ───────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=ErrandGuy
APP_URL=http://localhost:3000
PORT=3000
# Global route prefix. The Laravel API lived at /api/v1 — keep it identical.
API_PREFIX=api/v1

# ─── Database (shared Supabase Postgres — SAME DB as the Laravel app) ────────
# Pooled connection (pgbouncer) for the app; direct connection for prisma db pull.
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:6543/postgres?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# ─── Auth (Laravel Sanctum-compatible) ───────────────────────────────────────
# Minutes until an issued token expires. Matches Laravel SANCTUM_EXPIRATION (30 days).
SANCTUM_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=
# The polymorphic class names stored in personal_access_tokens.tokenable_type.
# Kept verbatim so tokens issued by the Laravel app keep authenticating.
TOKENABLE_USER_TYPE=App\\Models\\User
TOKENABLE_ADMIN_TYPE=App\\Models\\AdminUser
# bcrypt cost used when hashing new passwords (Laravel used 12).
BCRYPT_ROUNDS=12
# AES-256 key (base64, 32 bytes) for encrypting runner bank_account_number at
# rest (mirrors Laravel Crypt). Generate: `openssl rand -base64 32`.
# NOTE: the format differs from Laravel's Crypt payload — see README "Parity notes"
# if you must decrypt bank numbers written by the old Laravel app.
APP_ENCRYPTION_KEY=

# ─── CORS / limits ────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:3000
API_MAX_BODY_BYTES=1048576
API_MAX_UPLOAD_BYTES=12582912

# ─── Integrations ─────────────────────────────────────────────────────────────
# Firebase / FCM (push). Provide the service-account JSON path OR inline JSON.
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=

# Resend (transactional email)
RESEND_API_KEY=
MAIL_FROM_ADDRESS=no-reply@errandguy.app
MAIL_FROM_NAME=ErrandGuy

# Xendit (payments)
XENDIT_SECRET_KEY=
XENDIT_PUBLIC_KEY=
XENDIT_WEBHOOK_TOKEN=

# Supabase (storage + realtime table writes)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Mapbox (distance/geocoding)
MAPBOX_SECRET_TOKEN=

# ─── Queue / scheduler ────────────────────────────────────────────────────────
# The DB-backed queue worker polls this often (ms) and the scheduler runs sweeps.
QUEUE_POLL_MS=2000
QUEUE_ENABLED=true
SCHEDULER_ENABLED=true
