// ErrandGuy — Prisma schema.
//
// Hand-authored to match the EXISTING Supabase Postgres schema created by the
// Laravel migrations (the DB is shared and unchanged). TS field names are
// camelCase; @map/@@map pin them to the real snake_case columns/tables.
//
// IMPORTANT: never run `prisma migrate` against the shared DB — it would try to
// drop the Laravel framework tables (cache, jobs, sessions, …) that this schema
// deliberately does not model. Use `prisma db pull` to resync, and apply the
// additive `queued_jobs` table via prisma/sql/000_queued_jobs.sql by hand.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity & auth
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone            String?   @unique @db.VarChar(20)
  email            String?   @unique @db.VarChar(255)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  fullName         String    @map("full_name") @db.VarChar(100)
  avatarUrl        String?   @map("avatar_url") @db.Text
  role             String    @db.VarChar(10)
  status           String    @default("active") @db.VarChar(15)
  emailVerified    Boolean   @default(false) @map("email_verified")
  phoneVerified    Boolean   @default(false) @map("phone_verified")
  defaultLat       Decimal?  @map("default_lat") @db.Decimal(10, 7)
  defaultLng       Decimal?  @map("default_lng") @db.Decimal(10, 7)
  fcmToken         String?   @map("fcm_token") @db.Text
  walletBalance    Decimal   @default(0) @map("wallet_balance") @db.Decimal(12, 2)
  xenditCustomerId String?   @map("xendit_customer_id") @db.VarChar(255)
  avgRating        Decimal   @default(0) @map("avg_rating") @db.Decimal(3, 2)
  totalRatings     Int       @default(0) @map("total_ratings")
  lastActiveAt     DateTime? @map("last_active_at") @db.Timestamptz(6)
  referralCode     String?   @unique @map("referral_code") @db.VarChar(12)
  referredBy       String?   @map("referred_by") @db.Uuid
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  runnerProfile     RunnerProfile?
  customerBookings  Booking[]           @relation("CustomerBookings")
  runnerBookings    Booking[]           @relation("RunnerBookings")
  statusLogChanges  BookingStatusLog[]  @relation("StatusLogChangedBy")
  runnerLocations   RunnerLocation[]    @relation("RunnerLocationRunner")
  payments          Payment[]           @relation("CustomerPayments")
  paymentMethods    PaymentMethod[]
  walletTransactions WalletTransaction[]
  messages          Message[]           @relation("MessageSender")
  reviewsGiven      Review[]            @relation("ReviewReviewer")
  reviewsReceived   Review[]            @relation("ReviewReviewee")
  notifications     Notification[]
  savedAddresses    SavedAddress[]
  trustedContacts   TrustedContact[]
  sosAsCustomer     SosAlert[]          @relation("SosCustomer")
  sosAsRunner       SosAlert[]          @relation("SosRunner")
  sosTriggered      SosAlert[]          @relation("SosTriggeredBy")
  disputesReported  DisputeTicket[]     @relation("DisputeReporter")
  referralsMade     Referral[]          @relation("ReferralReferrer")
  referralsReceived Referral[]          @relation("ReferralReferee")
  supportTickets    SupportTicket[]
  supportMessages   SupportMessage[]    @relation("SupportMessageSender")
  referrer          User?               @relation("UserReferrals", fields: [referredBy], references: [id], onDelete: SetNull)
  referredUsers     User[]              @relation("UserReferrals")

  @@index([phone], map: "idx_users_phone")
  @@index([email], map: "idx_users_email")
  @@index([role, status], map: "idx_users_role_status")
  @@index([referredBy], map: "idx_users_referred_by")
  @@map("users")
}

model AdminUser {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  fullName        String    @map("full_name") @db.VarChar(100)
  role            String    @default("admin") @db.VarChar(20)
  twoFactorSecret String?   @map("two_factor_secret") @db.Text
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("admin_users")
}

// Laravel Sanctum personal access tokens. `token` = sha256 hex of the plaintext
// half of a "{id}|{plaintext}" bearer. `tokenable_type` is the morph class name
// ("App\\Models\\User" | "App\\Models\\AdminUser") — kept verbatim for parity.
model PersonalAccessToken {
  id            BigInt    @id @default(autoincrement())
  tokenableType String    @map("tokenable_type") @db.VarChar(255)
  tokenableId   String    @map("tokenable_id") @db.Uuid
  name          String    @db.Text
  token         String    @unique @db.VarChar(64)
  abilities     String?   @db.Text
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamp(0)
  expiresAt     DateTime? @map("expires_at") @db.Timestamp(0)
  createdAt     DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime? @map("updated_at") @db.Timestamp(0)

  @@index([tokenableType, tokenableId], map: "personal_access_tokens_tokenable_type_tokenable_id_index")
  @@index([expiresAt])
  @@map("personal_access_tokens")
}

model PasswordResetToken {
  email     String    @id @db.VarChar(255)
  token     String    @db.VarChar(255)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)

  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Runner
// ─────────────────────────────────────────────────────────────────────────────

model RunnerProfile {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  verificationStatus String    @default("pending") @map("verification_status") @db.VarChar(15)
  vehicleType        String?   @map("vehicle_type") @db.VarChar(15)
  vehiclePlate       String?   @map("vehicle_plate") @db.VarChar(20)
  vehiclePhotoUrl    String?   @map("vehicle_photo_url") @db.Text
  isOnline           Boolean   @default(false) @map("is_online")
  currentLat         Decimal?  @map("current_lat") @db.Decimal(10, 7)
  currentLng         Decimal?  @map("current_lng") @db.Decimal(10, 7)
  lastLocationAt     DateTime? @map("last_location_at") @db.Timestamptz(6)
  acceptanceRate     Decimal   @default(0) @map("acceptance_rate") @db.Decimal(5, 2)
  completionRate     Decimal   @default(0) @map("completion_rate") @db.Decimal(5, 2)
  totalErrands       Int       @default(0) @map("total_errands")
  totalEarnings      Decimal   @default(0) @map("total_earnings") @db.Decimal(12, 2)
  preferredTypes     Json      @default("[]") @map("preferred_types") @db.JsonB
  workingAreaLat     Decimal?  @map("working_area_lat") @db.Decimal(10, 7)
  workingAreaLng     Decimal?  @map("working_area_lng") @db.Decimal(10, 7)
  workingAreaRadius  Int       @default(5000) @map("working_area_radius")
  bankName           String?   @map("bank_name") @db.VarChar(100)
  bankAccountNumber  String?   @map("bank_account_number") @db.Text
  ewalletNumber      String?   @map("ewallet_number") @db.VarChar(20)
  approvedAt         DateTime? @map("approved_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents RunnerDocument[]

  @@index([userId], map: "idx_runner_profiles_user_id")
  // Covering composite for the runner-matching geo scan (is_online +
  // verification_status + current_lat range). Mirrors the Laravel migration
  // 2026_07_24_000002_swap_runner_profiles_geo_composite_index (audit P21) —
  // it subsumes the old (is_online, verification_status) index as a prefix and
  // replaces the dead standalone current_lat index (lat is never filtered
  // without lng). The Laravel migration is the source of truth for this shared
  // table; keep these @@index lines in lockstep with it.
  @@index([isOnline, verificationStatus, currentLat], map: "idx_runner_profiles_online_status_lat")
  @@map("runner_profiles")
}

model RunnerDocument {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runnerId        String    @map("runner_id") @db.Uuid
  documentType    String    @map("document_type") @db.VarChar(25)
  fileUrl         String    @map("file_url") @db.Text
  status          String    @default("pending") @db.VarChar(15)
  rejectionReason String?   @map("rejection_reason") @db.Text
  reviewedBy      String?   @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  runner RunnerProfile @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  @@index([runnerId], map: "idx_runner_documents_runner_id")
  @@index([runnerId, status])
  @@map("runner_documents")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────────────────────────

model ErrandType {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String   @unique @db.VarChar(30)
  name            String   @db.VarChar(50)
  description     String   @db.Text
  iconName        String   @map("icon_name") @db.VarChar(30)
  baseFee         Decimal  @map("base_fee") @db.Decimal(8, 2)
  perKmWalk       Decimal  @map("per_km_walk") @db.Decimal(6, 2)
  perKmBicycle    Decimal  @map("per_km_bicycle") @db.Decimal(6, 2)
  perKmMotorcycle Decimal  @map("per_km_motorcycle") @db.Decimal(6, 2)
  perKmCar        Decimal  @map("per_km_car") @db.Decimal(6, 2)
  surcharge       Decimal  @default(0) @db.Decimal(6, 2)
  minNegotiateFee Decimal  @map("min_negotiate_fee") @db.Decimal(8, 2)
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  bookings Booking[]

  @@index([isActive])
  @@map("errand_types")
}

// ─────────────────────────────────────────────────────────────────────────────
// Bookings
// ─────────────────────────────────────────────────────────────────────────────

model Booking {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingNumber       String    @unique @map("booking_number") @db.VarChar(20)
  customerId          String    @map("customer_id") @db.Uuid
  runnerId            String?   @map("runner_id") @db.Uuid
  errandTypeId        String    @map("errand_type_id") @db.Uuid
  status              String    @default("pending") @db.VarChar(25)
  pickupAddress       String    @map("pickup_address") @db.Text
  pickupLat           Decimal   @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng           Decimal   @map("pickup_lng") @db.Decimal(10, 7)
  pickupContactName   String?   @map("pickup_contact_name") @db.VarChar(100)
  pickupContactPhone  String?   @map("pickup_contact_phone") @db.VarChar(20)
  dropoffAddress      String?   @map("dropoff_address") @db.Text
  dropoffLat          Decimal?  @map("dropoff_lat") @db.Decimal(10, 7)
  dropoffLng          Decimal?  @map("dropoff_lng") @db.Decimal(10, 7)
  dropoffContactName  String?   @map("dropoff_contact_name") @db.VarChar(100)
  dropoffContactPhone String?   @map("dropoff_contact_phone") @db.VarChar(20)
  description         String?   @db.Text
  specialInstructions String?   @map("special_instructions") @db.Text
  itemPhotos          Json      @default("[]") @map("item_photos") @db.JsonB
  estimatedItemValue  Decimal?  @map("estimated_item_value") @db.Decimal(10, 2)
  shoppingBudget      Decimal?  @map("shopping_budget") @db.Decimal(10, 2)
  shoppingItems       Json?     @map("shopping_items") @db.JsonB
  actualItemCost      Decimal?  @map("actual_item_cost") @db.Decimal(10, 2)
  receiptPhotoUrl     String?   @map("receipt_photo_url") @db.Text
  scheduleType        String    @default("now") @map("schedule_type") @db.VarChar(10)
  scheduledAt         DateTime? @map("scheduled_at") @db.Timestamptz(6)
  pricingMode         String    @default("fixed") @map("pricing_mode") @db.VarChar(10)
  vehicleTypeRate     String?   @map("vehicle_type_rate") @db.VarChar(15)
  distanceKm          Decimal?  @map("distance_km") @db.Decimal(8, 2)
  baseFee             Decimal   @map("base_fee") @db.Decimal(8, 2)
  distanceFee         Decimal   @map("distance_fee") @db.Decimal(8, 2)
  serviceFee          Decimal   @map("service_fee") @db.Decimal(8, 2)
  surcharge           Decimal   @default(0) @db.Decimal(8, 2)
  promoDiscount       Decimal   @default(0) @map("promo_discount") @db.Decimal(8, 2)
  totalAmount         Decimal   @map("total_amount") @db.Decimal(10, 2)
  paymentMethod       String?   @map("payment_method") @db.VarChar(15)
  paymentStatus       String    @default("unpaid") @map("payment_status") @db.VarChar(15)
  customerOffer       Decimal?  @map("customer_offer") @db.Decimal(10, 2)
  recommendedMin      Decimal?  @map("recommended_min") @db.Decimal(10, 2)
  recommendedMax      Decimal?  @map("recommended_max") @db.Decimal(10, 2)
  runnerPayout        Decimal?  @map("runner_payout") @db.Decimal(10, 2)
  negotiateExpiresAt  DateTime? @map("negotiate_expires_at") @db.Timestamptz(6)
  pickupPhotoUrl      String?   @map("pickup_photo_url") @db.Text
  deliveryPhotoUrl    String?   @map("delivery_photo_url") @db.Text
  signatureUrl        String?   @map("signature_url") @db.Text
  matchedAt           DateTime? @map("matched_at") @db.Timestamptz(6)
  acceptedAt          DateTime? @map("accepted_at") @db.Timestamptz(6)
  pickedUpAt          DateTime? @map("picked_up_at") @db.Timestamptz(6)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason  String?   @map("cancellation_reason") @db.Text
  cancellationFee     Decimal   @default(0) @map("cancellation_fee") @db.Decimal(8, 2)
  cancelledBy         String?   @map("cancelled_by") @db.Uuid
  promoCodeId         String?   @map("promo_code_id") @db.Uuid
  ridePin             String?   @map("ride_pin") @db.VarChar(4)
  ridePinVerified     Boolean   @default(false) @map("ride_pin_verified")
  isTransportation    Boolean   @default(false) @map("is_transportation")
  sosTriggered        Boolean   @default(false) @map("sos_triggered")
  tripShareToken      String?   @unique @map("trip_share_token") @db.VarChar(64)
  tripShareActive     Boolean   @default(false) @map("trip_share_active")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer       User               @relation("CustomerBookings", fields: [customerId], references: [id])
  runner         User?              @relation("RunnerBookings", fields: [runnerId], references: [id])
  errandType     ErrandType         @relation(fields: [errandTypeId], references: [id])
  statusLogs     BookingStatusLog[]
  runnerLocations RunnerLocation[]
  payments       Payment[]
  messages       Message[]
  reviews        Review[]
  sosAlerts      SosAlert[]
  disputeTickets DisputeTicket[]
  supportTickets SupportTicket[]

  @@index([customerId], map: "idx_bookings_customer_id")
  @@index([runnerId], map: "idx_bookings_runner_id")
  @@index([status], map: "idx_bookings_status")
  @@index([bookingNumber], map: "idx_bookings_booking_number")
  @@index([createdAt], map: "idx_bookings_created_at")
  @@index([completedAt])
  @@index([paymentStatus], map: "idx_bookings_payment_status")
  @@index([customerId, status, createdAt], map: "idx_bookings_customer_status_created")
  @@index([runnerId, status, completedAt], map: "idx_bookings_runner_status_completed")
  @@index([status, pricingMode, negotiateExpiresAt], map: "idx_bookings_status_pricing_negotiate")
  @@map("bookings")
}

model BookingStatusLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  status    String   @db.VarChar(25)
  changedBy String?  @map("changed_by") @db.Uuid
  note      String?  @db.Text
  lat       Decimal? @db.Decimal(10, 7)
  lng       Decimal? @db.Decimal(10, 7)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedByUser User? @relation("StatusLogChangedBy", fields: [changedBy], references: [id])

  @@index([bookingId], map: "idx_booking_status_logs_booking_id")
  @@index([bookingId, createdAt], map: "idx_status_logs_booking_created")
  @@map("booking_status_logs")
}

model RunnerLocation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String?  @map("booking_id") @db.Uuid
  runnerId  String   @map("runner_id") @db.Uuid
  lat       Decimal  @db.Decimal(10, 7)
  lng       Decimal  @db.Decimal(10, 7)
  heading   Decimal? @db.Decimal(5, 2)
  speed     Decimal? @db.Decimal(5, 2)
  accuracy  Decimal? @db.Decimal(5, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking? @relation(fields: [bookingId], references: [id])
  runner  User     @relation("RunnerLocationRunner", fields: [runnerId], references: [id])

  @@index([bookingId], map: "idx_runner_locations_booking_id")
  @@index([runnerId, createdAt], map: "idx_runner_locations_runner_id_created")
  @@index([bookingId, createdAt], map: "idx_runner_locations_booking_created")
  @@map("runner_locations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Payments & wallet
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId       String    @map("booking_id") @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  amount          Decimal   @db.Decimal(10, 2)
  currency        String    @default("PHP") @db.VarChar(5)
  method          String    @db.VarChar(15)
  status          String    @default("pending") @db.VarChar(15)
  gatewayTxId     String?   @map("gateway_tx_id") @db.VarChar(100)
  gatewayResponse Json?     @map("gateway_response") @db.JsonB
  paidAt          DateTime? @map("paid_at") @db.Timestamptz(6)
  refundAmount    Decimal?  @map("refund_amount") @db.Decimal(10, 2)
  refundedAt      DateTime? @map("refunded_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking     Booking                   @relation(fields: [bookingId], references: [id])
  customer    User                      @relation("CustomerPayments", fields: [customerId], references: [id])
  transitions PaymentStatusTransition[]

  @@index([bookingId], map: "idx_payments_booking_id")
  @@index([customerId], map: "idx_payments_customer_id")
  @@map("payments")
}

model PaymentMethod {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  type         String    @db.VarChar(15)
  status       String    @default("active") @db.VarChar(15)
  label        String    @db.VarChar(50)
  gatewayToken String?   @map("gateway_token") @db.Text
  gatewayRef   String?   @map("gateway_ref") @db.VarChar(255)
  isDefault    Boolean   @default(false) @map("is_default")
  lastFour     String?   @map("last_four") @db.VarChar(4)
  cardBrand    String?   @map("card_brand") @db.VarChar(20)
  channelCode  String?   @map("channel_code") @db.VarChar(20)
  expiresAt    DateTime? @map("expires_at") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_payment_methods_user_id")
  @@map("payment_methods")
}

model WalletTransaction {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  type          String    @db.VarChar(15)
  amount        Decimal   @db.Decimal(10, 2)
  balanceAfter  Decimal   @map("balance_after") @db.Decimal(12, 2)
  referenceId   String?   @map("reference_id") @db.Uuid
  gatewayRef    String?   @map("gateway_ref") @db.VarChar(100)
  checkoutUrl   String?   @map("checkout_url") @db.Text
  description   String?   @db.Text
  status        String    @default("completed") @db.VarChar(15)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  failureReason String?   @map("failure_reason") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt], map: "idx_wallet_transactions_user_id_created")
  @@index([type, status], map: "idx_wallet_transactions_type_status")
  @@index([gatewayRef], map: "idx_wallet_transactions_gateway_ref")
  @@map("wallet_transactions")
}

model PaymentStatusTransition {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId  String   @map("payment_id") @db.Uuid
  fromStatus String?  @map("from_status") @db.VarChar(15)
  toStatus   String   @map("to_status") @db.VarChar(15)
  actor      String?  @db.VarChar(60)
  reason     String?  @db.VarChar(191)
  meta       Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId], map: "idx_pst_payment_id")
  @@map("payment_status_transitions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Chat, reviews, notifications
// ─────────────────────────────────────────────────────────────────────────────

model Message {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String    @map("booking_id") @db.Uuid
  senderId  String    @map("sender_id") @db.Uuid
  content   String?   @db.Text
  imageUrl  String?   @map("image_url") @db.Text
  isSystem  Boolean   @default(false) @map("is_system")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender  User    @relation("MessageSender", fields: [senderId], references: [id])

  @@index([bookingId, createdAt], map: "idx_messages_booking_id_created")
  @@index([bookingId, senderId, readAt], map: "idx_messages_booking_sender_read")
  @@index([bookingId, createdAt], map: "idx_messages_booking_created")
  @@map("messages")
}

model Review {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  reviewerId String  @map("reviewer_id") @db.Uuid
  revieweeId String  @map("reviewee_id") @db.Uuid
  rating    Int      @db.SmallInt
  comment   String?  @db.Text
  isFlagged Boolean  @default(false) @map("is_flagged")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  booking  Booking @relation(fields: [bookingId], references: [id])
  reviewer User    @relation("ReviewReviewer", fields: [reviewerId], references: [id])
  reviewee User    @relation("ReviewReviewee", fields: [revieweeId], references: [id])

  @@unique([bookingId, reviewerId])
  @@index([revieweeId], map: "idx_reviews_reviewee_id")
  @@map("reviews")
}

model Notification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  title      String    @db.VarChar(100)
  body       String    @db.Text
  type       String    @db.VarChar(20)
  data       Json?     @db.JsonB
  isRead     Boolean   @default(false) @map("is_read")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "idx_notifications_user_id_created")
  @@index([userId, isRead], map: "idx_notifications_user_is_read")
  @@index([userId, archivedAt], map: "idx_notifications_user_id_archived")
  @@map("notifications")
}

