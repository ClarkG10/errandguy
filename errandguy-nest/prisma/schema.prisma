  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("system_config")
}

model IdempotencyKey {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  idemKey      String    @map("idem_key") @db.VarChar(191)
  method       String    @db.VarChar(10)
  path         String    @db.VarChar(191)
  requestHash  String    @map("request_hash") @db.VarChar(64)
  status       String    @default("in_progress") @db.VarChar(12)
  responseCode Int?      @map("response_code") @db.SmallInt
  responseBody Json?     @map("response_body") @db.JsonB
  lockedAt     DateTime? @map("locked_at") @db.Timestamptz(6)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, idemKey], map: "uq_idem_user_key")
  @@index([expiresAt], map: "idx_idem_expires")
  @@map("idempotency_keys")
}

model WebhookEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String    @default("xendit") @db.VarChar(20)
  eventId     String    @map("event_id") @db.VarChar(191)
  eventType   String?   @map("event_type") @db.VarChar(60)
  payload     Json?     @db.JsonB
  status      String    @default("received") @db.VarChar(12)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, eventId], map: "uq_webhook_provider_event")
  @@map("webhook_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// NestJS DB-backed queue (ADDITIVE — apply prisma/sql/000_queued_jobs.sql).
// Replaces Laravel's `jobs` table for delayed/retryable background work.
// ─────────────────────────────────────────────────────────────────────────────

model QueuedJob {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(100)
  payload     Json      @db.JsonB
  availableAt DateTime  @map("available_at") @db.Timestamptz(6)
  reservedAt  DateTime? @map("reserved_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  status      String    @default("pending") @db.VarChar(12)
  lastError   String?   @map("last_error") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, availableAt], map: "idx_queued_jobs_status_available")
  @@map("queued_jobs")
}
