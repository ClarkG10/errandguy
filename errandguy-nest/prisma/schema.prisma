// ─────────────────────────────────────────────────────────────────────────────
// Safety
// ─────────────────────────────────────────────────────────────────────────────

model SosAlert {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId         String    @map("booking_id") @db.Uuid
  customerId        String    @map("customer_id") @db.Uuid
  runnerId          String?   @map("runner_id") @db.Uuid
  triggeredBy       String?   @map("triggered_by") @db.Uuid
  triggeredByRole   String?   @map("triggered_by_role") @db.VarChar(15)
  triggeredAt       DateTime  @map("triggered_at") @db.Timestamptz(6)
  customerLat       Decimal?  @map("customer_lat") @db.Decimal(10, 7)
  customerLng       Decimal?  @map("customer_lng") @db.Decimal(10, 7)
  runnerLat         Decimal?  @map("runner_lat") @db.Decimal(10, 7)
  runnerLng         Decimal?  @map("runner_lng") @db.Decimal(10, 7)
  contactsNotified  Json      @default("[]") @map("contacts_notified") @db.JsonB
  liveLinkToken     String?   @map("live_link_token") @db.VarChar(64)
  liveLinkExpiresAt DateTime? @map("live_link_expires_at") @db.Timestamptz(6)
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolutionNote    String?   @map("resolution_note") @db.Text
  status            String    @default("active") @db.VarChar(15)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  booking     Booking @relation(fields: [bookingId], references: [id])
  customer    User    @relation("SosCustomer", fields: [customerId], references: [id])
  runner      User?   @relation("SosRunner", fields: [runnerId], references: [id])
  triggeredByUser User? @relation("SosTriggeredBy", fields: [triggeredBy], references: [id])

  @@index([bookingId], map: "idx_sos_alerts_booking_id")
  @@index([status])
  @@index([triggeredBy], map: "idx_sos_alerts_triggered_by")
  @@map("sos_alerts")
}

// ─────────────────────────────────────────────────────────────────────────────
// Promos & referrals
// ─────────────────────────────────────────────────────────────────────────────

model PromoCode {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String   @unique @db.VarChar(30)
  description   String?  @db.Text
  discountType  String   @map("discount_type") @db.VarChar(10)
  discountValue Decimal  @map("discount_value") @db.Decimal(8, 2)
  maxDiscount   Decimal? @map("max_discount") @db.Decimal(8, 2)
  minOrder      Decimal  @default(0) @map("min_order") @db.Decimal(8, 2)
  usageLimit    Int?     @map("usage_limit")
  perUserLimit  Int      @default(1) @map("per_user_limit")
  usedCount     Int      @default(0) @map("used_count")
  validFrom     DateTime @map("valid_from") @db.Timestamptz(6)
  validUntil    DateTime @map("valid_until") @db.Timestamptz(6)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([code, isActive])
  @@map("promo_codes")
}

model Referral {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrerId   String    @map("referrer_id") @db.Uuid
  refereeId    String    @map("referee_id") @db.Uuid
  status       String    @default("pending") @db.VarChar(15)
  rewardAmount Decimal?  @map("reward_amount") @db.Decimal(10, 2)
  qualifiedAt  DateTime? @map("qualified_at") @db.Timestamptz(6)
  rewardedAt   DateTime? @map("rewarded_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  referrer User @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("ReferralReferee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@unique([refereeId], map: "uq_referrals_referee_id")
  @@index([referrerId], map: "idx_referrals_referrer_id")
  @@map("referrals")
}

// ─────────────────────────────────────────────────────────────────────────────
// Support & disputes
// ─────────────────────────────────────────────────────────────────────────────

model DisputeTicket {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId    String    @map("booking_id") @db.Uuid
  reportedBy   String    @map("reported_by") @db.Uuid
  category     String    @db.VarChar(30)
  description  String    @db.Text
  evidenceUrls Json      @default("[]") @map("evidence_urls") @db.JsonB
  status       String    @default("open") @db.VarChar(15)
  resolution   String?   @db.Text
  resolvedBy   String?   @map("resolved_by") @db.Uuid
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking  Booking @relation(fields: [bookingId], references: [id])
  reporter User    @relation("DisputeReporter", fields: [reportedBy], references: [id])

  @@index([bookingId], map: "idx_dispute_tickets_booking_id")
  @@index([status])
  @@index([reportedBy])
  @@map("dispute_tickets")
}

model SupportTicket {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  bookingId     String?   @map("booking_id") @db.Uuid
  subject       String    @db.VarChar(255)
  category      String    @db.VarChar(255)
  status        String    @default("open") @db.VarChar(255)
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking  Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@index([userId, status], map: "idx_support_tickets_user_status")
  @@map("support_tickets")
}

model SupportMessage {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId   String    @map("ticket_id") @db.Uuid
  senderId   String?   @map("sender_id") @db.Uuid
  senderType String    @map("sender_type") @db.VarChar(255)
  content    String    @db.Text
  imageUrl   String?   @map("image_url") @db.Text
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User?         @relation("SupportMessageSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt], map: "idx_support_messages_ticket_created")
  @@map("support_messages")
}

